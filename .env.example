# Copy to .env and update
# If you use Supabase, set `DATABASE_URL` to the Supabase Postgres connection string.
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres:your-password@db.example.com:6543/postgres?pgbouncer=true"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres:your-password@db.example.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

