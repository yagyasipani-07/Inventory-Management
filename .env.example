# App Environment
NEXT_PUBLIC_APP_NAME="Paras Plywoods ERP"
NEXT_PUBLIC_ENVIRONMENT="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api"

# Supabase Platform
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage
NEXT_PUBLIC_STORAGE_BUCKET="paras-plywoods-bucket"

# Database (Legacy/Migration only)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paras_plywoods?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/paras_plywoods?schema=public"

# Auth (Placeholders)
NEXT_PUBLIC_AUTH_ENABLED="false"
AUTH_SECRET="your-super-secret-key-for-auth"
